# === Google Sheets ===
# Email dari Service Account Google Cloud (lihat README.md bagian setup)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com

# Private key dari file JSON service account. Tempel PERSIS termasuk BEGIN/END,
# ganti setiap baris baru menjadi \n (biasanya sudah otomatis begitu di file JSON-nya).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxx\n-----END PRIVATE KEY-----\n"

# ID Spreadsheet (bagian di URL: https://docs.google.com/spreadsheets/d/ID_INI/edit)
GOOGLE_SHEET_ID=

# Nama tab/sheet (opsional, default sudah sesuai di bawah ini)
SHEET_SDM=SDM
SHEET_DESA=DesaDampingan
SHEET_MENUS=Menus
SHEET_KELUARGA=AnggotaKeluarga
SHEET_CREDENTIALS=Credentials
SHEET_FIELD_CONFIG=FieldConfig

# === Login Admin ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Secret untuk menandatangani session cookie admin (boleh string acak apa saja, minimal 20 karakter)
SESSION_SECRET=ganti-dengan-string-acak-panjang
